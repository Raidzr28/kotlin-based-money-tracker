{"nodes": [{"id": "app_src_main_res_drawable_nodpi_goal_emergency", "label": "Emergency Fund Goal Cover Photo (City Skyline)", "file_type": "image", "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock urban skyline photograph (dense Manhattan-style high-rise blocks, hazy pastel sky, high vantage point). Not a UI screenshot, chart or diagram: it is decorative cover art for the built-in 'Emergency Fund' savings goal. The aspirational-but-sober city framing signals stability and security rather than a reward or splurge goal."}, {"id": "app_src_main_res_drawable_nodpi_goal_emergency_emergency_fund_goal", "label": "Emergency Fund Savings Goal", "file_type": "concept", "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seeded or default savings goal in the app. The existence of a matching drawable implies goals carry a cover image keyed by goal identity, alongside target amount and progress."}, {"id": "app_src_main_res_drawable_nodpi_goal_emergency_goal_cover_art_convention", "label": "goal_<name> Cover Art Naming Convention", "file_type": "rationale", "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File named goal_emergency.jpg: the goal_<key> prefix lets goal cover art be resolved by identifier (resource-name lookup or a key to drawable map) rather than each goal hardcoding a drawable reference. Adding a goal type means dropping in goal_<key>.jpg."}, {"id": "app_src_main_res_drawable_nodpi_goal_emergency_nodpi_density_bucket", "label": "drawable-nodpi Photographic Asset Bucket", "file_type": "rationale", "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed in drawable-nodpi so the photo ships once and is never density-scaled by the resource system. Trade-off: one moderate-resolution JPEG instead of an mdpi..xxxhdpi ladder, keeping APK size down at the cost of sharpness on high-density screens. JPEG rather than PNG or vector because it is a photograph."}, {"id": "app_src_main_res_drawable_nodpi_goal_emergency_portrait_hero_crop", "label": "Portrait 4:5 Hero Crop for Goal Cards", "file_type": "concept", "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tall portrait aspect (roughly 4:5), consistent with a goal card hero or full-bleed goal detail header in a vertically scrolling list, not a wide banner."}, {"id": "app_src_main_res_drawable_nodpi_goal_emergency_muted_overlay_safe_palette", "label": "Muted Desaturated Palette for Text Overlay Legibility", "file_type": "rationale", "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-saturation neutrals (warm brick, grey-blue glass, pale sky) with no high-chroma focal point and a bright, low-detail sky band across the top. This keeps white or scrim-backed text (goal name, amount saved, progress) legible over the image and lets it sit under a Material theme without clashing."}], "edges": [{"source": "app_src_main_res_drawable_nodpi_goal_emergency", "target": "app_src_main_res_drawable_nodpi_goal_emergency_emergency_fund_goal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "app/src/main/res/drawable-nodpi/goal_emergency.jpg", "source_location": null, "weight": 1.0}, {"source": "app_src_main_res_drawable_nodpi_goal_emergency", "tar