{"nodes": [{"id": "build_scaffold", "label": "Build Guide (UI scaffold)", "file_type": "document", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_no_hilt", "label": "No Hilt", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One database, one repository, one view model: MoneyApp is the whole dependency graph in twenty lines. Swapping to Hilt later changes nothing above it."}, {"id": "build_no_chart_library", "label": "No Chart Library (Canvas charts)", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The design needs a ring with labels on the arc and a mirrored net-worth sounding that neither Vico nor MPAndroidChart draws, and a chart library brings its own house style into a committed visual world."}, {"id": "build_no_material_you", "label": "No Material You by default", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The depth palette is what makes the waterline legible; a wallpaper-derived scheme reorders it. Offered as an explicit opt-in in Settings > Appearance."}, {"id": "build_no_date_picker_on_log", "label": "No Date Picker When Logging", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything logs as now to keep the hurry path short; bills and goals do get a picker."}, {"id": "build_blocked_cloud_integrations", "label": "Gmail / Drive / Firebase Blocked, Not Deferred", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each needs a Google Cloud or Firebase project owned by whoever ships this, with OAuth clients tied to the release signing certificate. There is nothing useful to write until those exist."}, {"id": "build_two_permissions", "label": "Only Two Permissions", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST_NOTIFICATIONS for bill reminders, asked at the toggle and never at startup; INTERNET only for the exchange-rate lookup, whose request carries a currency code and no identifier. No camera permission (system camera app is delegated to) and no storage permission (receipt photos live in app-private storage)."}, {"id": "build_sqlite_floor", "label": "SQL Has A Floor (minSdk 26 SQLite)", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INSERT ... ON CONFLICT DO UPDATE needs SQLite 3.24, which did not arrive until API 30. It was in MerchantMemoryDao.remember, which runs on every manually logged transaction, and it threw on Android 8, 9 and 10. UPDATE-then-INSERT is the portable upsert."}, {"id": "build_derived_totals", "label": "Totals Derived At Read Time", "file_type": "rationale", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LedgerState computes every headline figure from the ledger on read; an account balance is the opening figure plus every transaction since, never a stored total that can drift from the rows."}, {"id": "build_test_suite", "label": "100 Unit Tests", "file_type": "concept", "source_file": "BUILD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_repositorywritetest", "label": "RepositoryWri