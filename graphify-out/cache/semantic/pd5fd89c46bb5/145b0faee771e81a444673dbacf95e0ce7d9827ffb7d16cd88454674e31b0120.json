{"nodes": [{"id": "product_product_brief", "label": "Product Brief", "file_type": "document", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_stack", "label": "Confirmed Stack (Kotlin + Compose M3)", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exchange rates use HttpURLConnection and the framework JSON parser because one GET returning one small object does not need an HTTP library."}, {"id": "product_no_hilt", "label": "Hilt Deliberately Absent", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One database, one repository and one view model do not need a dependency-injection framework; MoneyApp is the whole graph in twenty lines and swapping to Hilt later changes nothing above it."}, {"id": "product_zero_cost_constraint", "label": "Zero Running Cost Forever", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$0 to build and run except the one-time $25 Play registration. Any feature needing a paid service is cut, not deferred, so the constraint cannot be eroded version by version."}, {"id": "product_no_bank_aggregation", "label": "Bank Aggregation Permanently Excluded", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plaid/Yodlee bill per linked account, which breaks the zero-cost constraint at any version; fast manual entry plus free capture paths buy the same completeness."}, {"id": "product_no_sms_autoread", "label": "SMS Auto-Read Permanently Excluded", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Play policy restricts READ_SMS/RECEIVE_SMS to apps whose core function is SMS handling; a finance app requesting it gets rejected."}, {"id": "product_gamification_over_real_data", "label": "Gamification Is A Layer Over Real Data", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Challenges are computed on every read and never stored, so there is no joined flag and no opt-in. The trade is that a user cannot start a challenge deliberately; what they get instead is an app that cannot claim a run their ledger does not support, and nothing to repair when an import or an undo rewrites history underneath it."}, {"id": "product_challenge_floor", "label": "Nothing Derived From Unkept Periods", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A challenge stops counting at the first transaction on record, so a fresh install is never handed a week of discipline it did not earn."}, {"id": "product_multi_currency_policy", "label": "Multi-Currency Conversion Policy", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accounts hold their own currency, every total converts into the base, and a currency with no rate is left out of the total and named on screen. Forty euros shown as forty dollars because a rate was missing is not an approximation, it is a wrong figure with a currency symbol on it."}, {"id": "product_denomination_from_account", "label": "Bills, Goals and Debts Read Currency From Their Account", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stored currency column would be a second home for the same fact, free to disagree with the first."}, {"id": "product_cross_currency_write_refusal", "label": "A Cross-Currency Write Converts Or Is Refused", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transfers, goal contributions and debt payments all return whether they happened, because a write that silently does not happen is the worst outcome available: the user believes it did."}, {"id": "product_ten_second_moment", "label": "The 10-Second Logging Moment", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_local_first", "label": "Offline Is The Default State", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local-first is the mechanism, not a limitation: the app is fully functional with the network off and sync is an opt-in layer. Offline is a normal state, not an error state."}, {"id": "product_mvp_v1", "label": "MVP v1 Scope (must be real)", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_number_right_before_beautiful", "label": "The Number Must Be Right Before It Is Beautiful", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Money data is never rounded, estimated, or animated into ambiguity; it is the user's own real money and wrong numbers are the worst possible failure."}, {"id": "product_logging_survives_a_hurry", "label": "Logging Must Survive A Hurry", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The add-transaction path is the most optimized path in the app because the core moment is one-handed, in public, before the user forgets; everything else can afford a tap."}, {"id": "product_nothing_posts_without_confirmation", "label": "Nothing Posts Without The User Confirming", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture assists (OCR, email, statement import) always pre-fill for confirmation and never post silently; automation pre-fills, the user commits."}, {"id": "product_binding_visual_constraint", "label": "UI 5.jpg Is Binding", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The visual world follows one user-supplied reference (deep blue, layered, glassy, hero ring chart, translucent stacked cards); the other four references are taste evidence only. No logo, wordmark, palette or voice guide exists yet and none may be fabricated as pre-existing."}, {"id": "product_accessibility_commitments", "label": "Accessibility and Inclusion Commitments", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamic type must not clip money values, 48dp minimum targets, colour is never the only carrier of the income/expense distinction, one-handed use stays possible, and both themes ship."}, {"id": "product_toolchain_jdk_constraint", "label": "JDK 15 vs AGP 8.7 Toolchain Gap", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system JDK is 15, which AGP 8.7 rejects, so Android Studio's bundled JDK is the expected build environment. No emulator or system image is installed, so nothing has been verified against a rendered screen."}], "edges": [{"source": "product_product_brief", "target": "readme_money_manager", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_product_brief", "target": "product_binding_visual_constraint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_product_brief", "target": "product_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_product_brief", "target": "product_zero_cost_constraint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_product_brief", "target": "product_mvp_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_product_brief", "target": "product_ten_second_moment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_product_brief", "target": "product_accessibility_commitments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": null, "weight": 1.0}, {"source": "product_stack", "target": "readme_suggested_tech_stack", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi